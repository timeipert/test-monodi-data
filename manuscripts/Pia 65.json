eren.","editionsstatus":"","custom":{"Cantus_Genre":"","Editor":"michael.klaper@t-online.de","iiifs":"","Bezugsgesang":"","Endseite":"198b","Startposition":"","Referenz_auf_Spiel":"","Endzeile":"11","Melodiennummer_Katalog":"","Cantus_Melody_ID":"","Cantus_ID":"","Melodie_Standard":"","Überlieferungszustand":"","Melodie_Quelle":"","FestUndGattung":"","Zusatz_zu_Textinitium":"","Nachtragsschicht":"","SpielName":"","subcorpus":"edition","publish":"all"}},{"id":"24aae51f-b704-4ea6-ab21-8bebdf8e173c","quelle_id":"Pia 65","dokumenten_id":"Pia 65-154v-b-7","gattung1":"Antiphon","gattung2":"Introitus","festtag":"Nativitas domini","feier":"2. Messe","textinitium":"Lux fulgebit","bibliographischerverweis":"AMS 10","druckausgabe":"II-4","zeilenstart":"7","foliostart":"154v-b","kommentar":"","editionsstatus":"","custom":{"Cantus_Genre":"","Editor":"michael.klaper@t-online.de","iiifs":"","Bezugsgesang":"","Endseite":"154v-b","Startposition":"","Referenz_auf_Spiel":"","Endzeile":"11","Melodiennummer_Katalog":"","Cantus_Melody_ID":"","Cantus_ID":"","Melodie_Standard":"","Überlieferungszustand":"","Melodie_Quelle":"","FestUndGattung":"","Zusatz_zu_Textinitium":"","Nachtragsschicht":"","SpielName":"","subcorpus":"edition","publish":"all"}},{"id":"cbd149a6-e37a-4469-970d-bf14d8960211","quelle_id":"Pia 65","dokumenten_id":"Pia 65-151v-a-11","gattung1":"Antiphon","gattung2":"Introitus","festtag":"Dominica I adventus","feier":"Messe","textinitium":"Ad te levavi","bibliographischerverweis":"AMS 1","druckausgabe":"II-4","zeilenstart":"11","foliostart":"151v-a","kommentar":"","editionsstatus":"","custom":{"Cantus_Genre":"","Editor":"michael.klaper@t-online.de","iiifs":"","Bezugsgesang":"","Endseite":"151v-b","Startposition":"","Referenz_auf_Spiel":"","Endzeile":"1","Melodiennummer_Katalog":"","Cantus_Melody_ID":"","Cantus_ID":"","Melodie_Standard":"","Überlieferungszustand":"","Melodie_Quelle":"","FestUndGattung":"","Zusatz_zu_Textinitium":"","Nachtragsschicht":"","SpielName":"","subcorpu